{
  "name": "ini-frontend",
  "private": true,
  "version": "0.0.0",
  "homepage": "https://veencnt.github.io/INI-frontend/",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && node scripts/build-sw.mjs",
    "deploy": "node scripts/deploy.mjs",
    "lint": "eslint .",
    "preview": "vite preview",
    "generate:api": "swagger-typescript-api generate -p ./swagger.json -o ./src/api/generated --axios --api-class-name BiochemicalIndicatorApi -n biochemicalIndicatorApi"
  },
  "dependencies": {
    "@reduxjs/toolkit": "^2.14.0",
    "axios": "^1.21.0",
    "bootstrap": "^5.3.8",
    "react": "^19.3.1",
    "react-bootstrap": "^2.10.10",
    "react-dom": "^19.3.1",
    "react-redux": "^9.3.1",
    "react-router-dom": "^7.18.4"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-bootstrap": "^1.0.1",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.13.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "gh-pages": "^6.3.0",
    "globals": "^17.13.0",
    "swagger-typescript-api": "^13.14.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2",
    "vite": "^8.3.4"
  }
}
